@namespace SwashbucklerDiary.Rcl.Components
@inherits CardComponentBase<DiaryModel>

<div class="timeline-item-wrapper @(IsActive ? "is-active" : "")">
    <!-- 时间线小节点（带悬停光晕） -->
    <div class="timeline-node">
        <div class="timeline-dot @(Value.Top ? "timeline-dot--top" : "")"></div>
    </div>

    <!-- 柔和毛玻璃时间线卡片 -->
    <MCard Class="@CardClass"
           OnClick="HandeOnClick"
           Elevation="0"
           Ripple="false"
           @oncontextmenu="OpenMenu"
           __internal_preventDefault_oncontextmenu>
        
        <!-- 顶栏：日期胶囊 + 时分胶囊 + 天气/心情 + 菜单 -->
        <div class="diary-card__header">
            <div class="diary-card__time-badge-group">
                <!-- 日期胶囊（如 2026/10/27 或 10/27） -->
                <span class="diary-card__date-pill">
                    @(Value.CreateTime.ToString(DateDisplayFormat))
                </span>

                <!-- 明确展示一天的时分（如 14:35） -->
                <span class="diary-card__time-pill">
                    <MIcon Small="true">schedule</MIcon>
                    <span>@(Value.CreateTime.ToString("HH:mm"))</span>
                </span>

                <!-- 星期微标 -->
                <span class="diary-card__week-pill ms-1">
                    @(I18n.ToWeek(Value.CreateTime))
                </span>

                <!-- 天气与心情图标 -->
                <div class="diary-card__status-badges">
                    @if (!string.IsNullOrEmpty(weatherIcon))
                    {
                        <MIcon Class="diary-card-icon diary-card__badge-icon">
                            @weatherIcon
                        </MIcon>
                    }

                    @if (!string.IsNullOrEmpty(moodIcon))
                    {
                        <MIcon Class="diary-card-icon diary-card__badge-icon">
                            @moodIcon
                        </MIcon>
                    }

                    @if (DiaryCardListOptions.Template && Value.Template && Value.Id == DiaryCardListOptions.DefaultTemplateId)
                    {
                        <MChip XSmall Color="primary" Outlined Class="ms-1">
                            @I18n.T("Defalut")
                        </MChip>
                    }
                </div>
            </div>

            <!-- 右侧状态徽章与更多菜单 -->
            <div class="d-flex align-center flex-shrink-0" @onclick:stopPropagation="true">
                @if (Value.Top)
                {
                    <MIcon Small Color="warning" Class="me-1">vertical_align_top</MIcon>
                }

                @if (Value.Template)
                {
                    <MIcon Small Color="info" Class="me-1">space_dashboard</MIcon>
                }

                <MButton @attributes="activatorAttributes"
                         Icon="true"
                         Small="true"
                         OnClick="OpenMenu">
                    <MIcon Small="true" Class="@MenuIconClass">
                        keyboard_arrow_down
                    </MIcon>
                </MButton>
            </div>
        </div>

        <!-- 标题（若有） -->
        @if (!string.IsNullOrEmpty(title))
        {
            <div class="diary-card__title">
                @title
            </div>
        }

        <!-- 正文内容预览（Markdown / 纯文本优雅折叠） -->
        <div class="diary-card__body">
            @if (Markdown)
            {
                <SimpleMarkdownPreview Value="@text"
                                       Style="pointer-events:none;"
                                       Optimize="false"
                                       Options="_markdownOptions">
                </SimpleMarkdownPreview>
            }
            else
            {
                <span>@text</span>
            }
        </div>

        <!-- 底部信息：标签与地理位置 -->
        @if ((Value.Tags is not null && Value.Tags.Count > 0) || !string.IsNullOrEmpty(Value.Location))
        {
            <div class="diary-card__footer">
                <div class="diary-card__tags-scroll diary-card__tags">
                    @if (Value.Tags is not null && Value.Tags.Count > 0)
                    {
                        @foreach (var item in Value.Tags)
                        {
                            <span @key="item.Id" class="diary-card__tag-pill">
                                #@item.Name
                            </span>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(Value.Location))
                {
                    <div class="diary-card__location diary-card__location-pill">
                        <MIcon Small="true">location_on</MIcon>
                        <span>@Value.Location</span>
                    </div>
                }
            </div>
        }
    </MCard>
</div>