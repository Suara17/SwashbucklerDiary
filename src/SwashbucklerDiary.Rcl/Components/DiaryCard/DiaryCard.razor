@namespace SwashbucklerDiary.Rcl.Components
@inherits CardComponentBase<DiaryModel>

<div class="timeline-item-wrapper">
    @if (IsFirstDayItem)
    {
        <!-- 按天聚合日期指示栏 (月份与日期) -->
        <div class="timeline-day-header">
            <div class="timeline-day-header__left"></div>
            <div class="timeline-day-header__dot">
                <span class="timeline-day-header__dot-core"></span>
            </div>
            <div class="timeline-day-header__pill">
                <MIcon Class="timeline-day-header__icon" Style="font-size:13px;">calendar_today</MIcon>
                <span class="timeline-day-header__text">@FormattedDateHeader</span>
            </div>
        </div>
    }

    <div class="timeline-row @(IsActive ? "is-active" : "")">
        <!-- 左侧时间戳 (HH:mm) -->
        <div class="timeline-time-col">
            @(Value.CreateTime.ToString("HH:mm"))
        </div>

        <!-- 中间节点图标 (圆圈 + 微标) -->
        <div class="timeline-node-col">
            <div class="timeline-node-badge @(Value.Top ? "timeline-node-badge--top" : "")">
                @if (!string.IsNullOrEmpty(weatherIcon))
                {
                    <MIcon Class="diary-card-icon" Style="font-size:14px;">
                        @weatherIcon
                    </MIcon>
                }
                else if (!string.IsNullOrEmpty(moodIcon))
                {
                    <MIcon Class="diary-card-icon" Style="font-size:14px;">
                        @moodIcon
                    </MIcon>
                }
                else if (Value.Top)
                {
                    <MIcon Style="font-size:14px;">star</MIcon>
                }
                else
                {
                    <MIcon Style="font-size:14px;">edit_note</MIcon>
                }
            </div>
        </div>

        <!-- 右侧紧凑型莫兰迪卡片 (点击展开/折叠，展开后点击内容直接跳转详情) -->
        <div class="timeline-card-col">
        <div class="diary-card-compact @(Value.Top ? "diary-card-compact--top" : "diary-card-compact--default") @(isExpanded ? "is-expanded" : "") @(IsActive ? "is-active" : "")"
             @onclick="HandleCardClick"
             @oncontextmenu="OpenMenu"
             __internal_preventDefault_oncontextmenu>
            
            <!-- 紧凑单行首部 (点击折叠或展开) -->
            <div class="compact-card__headline" @onclick="ToggleExpand" @onclick:stopPropagation="true">
                <div class="compact-card__title-box">
                    <span class="compact-card__title">
                        @(string.IsNullOrWhiteSpace(title) ? (string.IsNullOrWhiteSpace(text) ? I18n.T("Untitled") : text) : title)
                    </span>

                    @if (Value.Top)
                    {
                        <span class="compact-card__pill compact-card__pill--top">
                            @I18n.T("Top")
                        </span>
                    }

                    @if (DiaryCardListOptions.Template && Value.Template && Value.Id == DiaryCardListOptions.DefaultTemplateId)
                    {
                        <span class="compact-card__pill">
                            @I18n.T("Defalut")
                        </span>
                    }

                    @if (Value.Tags is not null && Value.Tags.Count > 0)
                    {
                        @foreach (var tag in Value.Tags.Take(2))
                        {
                            <span @key="tag.Id" class="compact-card__pill">
                                #@tag.Name
                            </span>
                        }
                    }
                </div>

                <MIcon Class="compact-card__arrow">
                    keyboard_arrow_down
                </MIcon>
            </div>

            <!-- 点击展开详情区 (展开后点击整个内容区直接跳转详情) -->
            <div class="compact-card__details" @onclick="HandleContentClick" @onclick:stopPropagation="true">
                <!-- 正文内容 (Markdown / 纯文本) -->
                @if (!string.IsNullOrWhiteSpace(text))
                {
                    <div class="compact-card__content">
                        @if (Markdown)
                        {
                            <SimpleMarkdownPreview Value="@text"
                                                   Style="pointer-events:none;"
                                                   Optimize="false"
                                                   Options="_markdownOptions">
                            </SimpleMarkdownPreview>
                        }
                        else
                        {
                            <span>@text</span>
                        }
                    </div>
                }

                <!-- 参考图风格内嵌白卡：地点与附加信息 -->
                @if (!string.IsNullOrEmpty(Value.Location))
                {
                    <div class="compact-card__inner-box">
                        <div class="compact-card__inner-left">
                            <MIcon Small="true">location_on</MIcon>
                            <span>@I18n.T("Location")</span>
                        </div>
                        <div class="compact-card__inner-right">
                            @Value.Location
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(weatherIcon) || !string.IsNullOrEmpty(moodIcon))
                {
                    <div class="compact-card__inner-box">
                        <div class="compact-card__inner-left">
                            <MIcon Small="true">wb_sunny</MIcon>
                            <span>@I18n.T("Status")</span>
                        </div>
                        <div class="compact-card__inner-right d-flex align-center">
                            @if (!string.IsNullOrEmpty(weatherIcon))
                            {
                                <MIcon Class="diary-card-icon me-1" Style="font-size:15px;">@weatherIcon</MIcon>
                            }
                            @if (!string.IsNullOrEmpty(moodIcon))
                            {
                                <MIcon Class="diary-card-icon" Style="font-size:15px;">@moodIcon</MIcon>
                            }
                        </div>
                    </div>
                }

                <!-- 展开底部轻量提示与操作行 (移除 Read 按钮，点击菜单按钮阻断跳转) -->
                <div class="compact-card__action-bar">
                    <div class="compact-card__tap-hint">
                        <MIcon Style="font-size:13px;" Class="me-1" Color="var(--theme-primary, #6C8A9C)">open_in_new</MIcon>
                        <span>@(I18n.T("Tap to read"))</span>
                    </div>

                    <div @onclick:stopPropagation="true">
                        <MButton @attributes="activatorAttributes"
                                 Icon="true"
                                 XSmall="true"
                                 OnClick="OpenMenu">
                            <MIcon XSmall="true">
                                more_horiz
                            </MIcon>
                        </MButton>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</div>